// Copy to wrangler.jsonc and fill in. Secrets are set with `wrangler secret put`, never here.
{
  "name": "eclipse-onedrive",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".output/public" },
  "vars": { "APP_URL": "https://your-domain.example" },
  "d1_databases": [
    { "binding": "DB", "database_name": "eclipse-onedrive", "database_id": "REPLACE_ME", "migrations_dir": "migrations" }
  ]
}
