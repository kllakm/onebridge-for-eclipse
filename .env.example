# PolyForm Noncommercial 1.0.0 + additional conditions; see LICENSE.md.
# EXAMPLES ONLY. Never commit real values. Set these as Cloudflare Worker
# Secrets for deployment. Copying this file does NOT bind D1 or configure Vite.
# For local development explicitly supply a server environment or configure
# Wrangler with ignored .dev.vars and a D1 binding named DB.
# Never prefix private values with VITE_: that exposes them to the browser.
# WARNING: general .env files are not currently ignored; .gitignore is managed
# externally. Use ignored .dev.vars for local secrets until exclusions are added.

# Entra app supporting organizational + personal Microsoft accounts.
MS_CLIENT_ID=REPLACE_WITH_YOUR_MICROSOFT_APPLICATION_CLIENT_ID
# Client secret VALUE, not Secret ID; renew before expiry.
MS_CLIENT_SECRET=REPLACE_WITH_YOUR_MICROSOFT_CLIENT_SECRET_VALUE
# Generate 32 random bytes, base64-encode, and back up privately.
TOKEN_ENC_KEY=REPLACE_WITH_YOUR_BASE64_ENCODED_32_BYTE_KEY
# HTTPS origin, no trailing slash. Web callback = APP_URL/api/onedrive/callback
APP_URL=https://YOUR-INSTANCE.example
# Optional; default is common.
MS_TENANT=common

# DB is a D1 runtime binding, not an environment connection string.
# Supply your own database_id/database_name in wrangler.jsonc; keep binding DB.
# Apply migrations 0001–0005 in order to a NEW empty database before use.
# A fresh installation needs secure account bootstrap: signups remain closed.